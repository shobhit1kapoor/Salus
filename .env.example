# Required for real AI requests. Obtain from NVIDIA API Catalog.
NVIDIA_API_KEY=
NVIDIA_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2.6
NVIDIA_CHAT_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_FALLBACK_MODEL=nvidia/nv-embedqa-e5-v5
# Hosted Speech NIM/Riva endpoint supplied by your NVIDIA deployment.
NVIDIA_ASR_BASE_URL=

# Protegrity AI Developer Edition hosted protection credentials.
# Data Discovery and Semantic Guardrails run locally through Docker Compose.
DEV_EDITION_EMAIL=
DEV_EDITION_PASSWORD=
DEV_EDITION_API_KEY=
PROTEGRITY_POLICY_USER=superuser
PROTEGRITY_CLASSIFICATION_THRESHOLD=0.60
PRIVACY_GATEWAY_URL=http://localhost:8080
PRIVACY_GATEWAY_TIMEOUT_MS=35000

POSTGRES_DB=salus
POSTGRES_USER=salus_admin
POSTGRES_PASSWORD=change-me-before-production
DATABASE_ADMIN_URL=postgresql://salus_admin:change-me-before-production@localhost:5432/salus
DATABASE_URL=postgresql://salus_app:change-me-before-production@localhost:5432/salus
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=salus-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-before-production
# 32-byte base64 key. Generate independently for every environment.
OBJECT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SESSION_SECRET=replace-with-at-least-32-random-characters
TOOL_CAPABILITY_SECRET=replace-with-a-distinct-32-character-secret
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Salus <noreply@salus.local>
SEED_REVIEWER_EMAIL=reviewer@salus.local
SEED_REVIEWER_PASSWORD=Salus-Reviewer-2026!
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com

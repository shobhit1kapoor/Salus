# Public DNS name. Create an A/AAAA record pointing here before starting Caddy.
SALUS_DOMAIN=salus.example.com
ACME_EMAIL=security@example.com

# Hosted NVIDIA endpoints. Never commit the real key.
NVIDIA_API_KEY=
NVIDIA_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2.6
NVIDIA_CHAT_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_FALLBACK_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_ASR_BASE_URL=

DEV_EDITION_EMAIL=
DEV_EDITION_PASSWORD=
DEV_EDITION_API_KEY=
PROTEGRITY_POLICY_USER=superuser
PROTEGRITY_CLASSIFICATION_THRESHOLD=0.60
PRIVACY_GATEWAY_URL=http://privacy-gateway:8080
PRIVACY_GATEWAY_TIMEOUT_MS=35000

POSTGRES_DB=salus
POSTGRES_USER=salus_admin
# Use a new URL-safe random value, such as 64 hexadecimal characters.
POSTGRES_PASSWORD=replace-with-new-url-safe-random-value

S3_REGION=us-east-1
S3_BUCKET=salus-private
S3_ACCESS_KEY=salus-storage
S3_SECRET_KEY=replace-with-new-random-value
# Base64-encoded 32-byte key. Losing it makes stored documents unrecoverable.
OBJECT_ENCRYPTION_KEY=replace-with-new-base64-encoded-32-byte-key

SESSION_SECRET=replace-with-at-least-32-random-characters
TOOL_CAPABILITY_SECRET=replace-with-a-distinct-32-character-secret
API_PORT=4000

# Use a real SMTP provider. Mailpit is intentionally absent in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM="Salus <noreply@example.com>"

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com

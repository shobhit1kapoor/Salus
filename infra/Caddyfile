{
	email {$ACME_EMAIL}
	admin off
}

{$SALUS_DOMAIN} {
	encode zstd gzip

	@api path /v1/* /health/*
	reverse_proxy @api api:4000
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

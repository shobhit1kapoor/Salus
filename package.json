{
  "name": "salus",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web,worker -c cyan,magenta,yellow \"npm run dev -w @salus/api\" \"npm run dev -w @salus/web\" \"npm run dev -w @salus/worker\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "schema:apply": "npm run schema:apply -w @salus/api",
    "seed": "npm run seed -w @salus/api",
    "salus80": "npm run salus80 -w @salus/testing"
  },
  "dependencies": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
